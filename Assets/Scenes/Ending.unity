  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "It was the morning of Day 21. The HZ-3280 began to surface, but you didn\u2019t want to go with it.\r\n\r\nPossessed by a will and vitality not your own, you escaped through the moonpool, leaving all of your diving gear behind.\r\n\r\nYou tirelessly swam out into the abyss until the fungal growths on your body grew large enough to forbid movement. \r\n\r\nYour body was rooted to the seabed as the shadow of a leviathan loomed over the husk of what was once you."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
