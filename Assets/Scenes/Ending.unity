--- !u!114 &853395143
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 853395142}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "On the morning of Day 21, your contract with Trident Excavation was officially completed. You waited in silence for what felt like an eternity as the HZ-3280 surfaced and successfully depressurized. \r\n\r\nThe woman who you recognized as your boss greeted you as you, the last of the survivors, stepped out of the submarine. Before you could say a word, she pushed a document into your hands. An NDA. \r\n\r\nLooking around, you saw the eyes of a dozen men in uniform assessing your every move. You signed the document.\r\n\r\nWith no hesitation, the men began to torch the HZ-3280 with all of its cargo still in tow. You stumbled forward to avoid the flames.\r\n\r\nYou were compensated as per your contract."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4285312337
  m_fontColor: {r: 0.31764707, g: 0.6784314, b: 0.42352945, a: 1}
