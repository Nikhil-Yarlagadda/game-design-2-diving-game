  m_Script: {fileID: 11500000, guid: df94f9603f601394389676b56feb4dcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ContactManager
  description: {fileID: 209287956}
  titleText: {fileID: 1163013786}
  captionText: {fileID: 1746301207}
  emails:
  - button: {fileID: 1732359922}
    titleLabel: {fileID: 1782995234}
    captionLabel: {fileID: 1840871876}
    icon: {fileID: 1037192641}
    notif: {fileID: 771125473}
    id: intro
    title: Trident Excavation
    caption: Welcome Aboard
    body: "Welcome, valued crew of the Extreme-depth Submergence Mining Vessel HZ-3280, to your first day on the job!\r\n\r\nThe object of this operation is the mining and extraction of tellurium from deep ocean sediment. You are at the forefront of the Company\u2019s push to dominate the market of this rare metal by tapping into a brand new source: the ocean floor.\r\n\r\nAs was covered in your contracts, the HZ-3280 is an exclusively remotely-operated vessel, meaning that propulsion and surfacing will be entirely under Company jurisdiction. For this operation, the vessel will remain stationary at a depth of approximately 600 meters from the days of July 27, 20XX to August 15, 20XX.\r\n\r\nShould your foreman wish to contact the Company for any reason, they may do so at the vessel\u2019s computer terminal. It is our top priority to provide prompt and effective assistance to our employees whenever needed. After all, you are our greatest assets!\r\n"
    requirement: 0
  - button: {fileID: 1939245647}
    titleLabel: {fileID: 1880958888}
    captionLabel: {fileID: 991598015}
    icon: {fileID: 289040712}
    notif: {fileID: 2031653704}
    id: medicine
    title: 'RE: Medicine Request'
    caption: Orange Susbstance
    body: "Thank you for contacting the Trident Excavation human resources department. Your concerns are very important to us. Our professionals have reviewed the relevant records and found no data resembling the reported \u201Corange substance.\u201D Therefore, we assure you that it is nothing to worry about.\r\n\r\nAs per your request, one (1) Antimicrobial Medicine is now available for purchase in your credit shop, which will be effective for treating most mild to moderate infections. Trident Excavation is unable to supply more than this, as that would be outside of your operation\u2019s allotted budget. Exceptions may only be made in the case that you provide us with photographic evidence of a major employee health concern.\r\n\r\nThank you for your flexibility, and happy mining!"
    requirement: 1
  - button: {fileID: 53783366}
    titleLabel: {fileID: 1381880979}
    captionLabel: {fileID: 130462908}
    icon: {fileID: 1192179010}
    notif: {fileID: 468596798}
    id: photo
    title: 'RE: Infection Photo'
    caption: Safety Procedures
    body: "Thank you for contacting the Trident Excavation human resources department. Your concerns are very important to us. \r\n\r\nThe Employee Safety and Budget Analyst boards have reviewed your image and determined that the recommended course of action is a standard quarantining procedure. Please instruct this employee to remain in an isolated space on the vessel for the remainder of the operation. If no space can be reserved for this purpose, simply ensure that the employee sleeps in a separate room from the rest of the crew, and maintain a distance of at least four (4) meters from them at all times. No more medicine can be supplied at this time.\r\n\r\nHappy mining!"
    requirement: 2
  request: {fileID: 665794882}
